{
    "id": "Compare-Cov-Single_MinMax",
    "comment": "Compare DiffRay coverage strategies (single, max-min)",
    "subtasks": [
        {
            "id": "single",
            "comment": "DiffRay Coverage Single Strategy",
            "cpus": 1,
            "params": {
                "fuzzer": "diffray",
                "max_time": 86400,
                "output_dir": "diffs",
                "corpus_dir": "corpus",
                "seed_dir": "seeds",
                "log_dir": "log",
                "verbose": "-v",
                "cov_mode": "single",
                "rv_mode": "none"
            },
            "prepare": [
                "seeds",
                "log",
                "corpus",
                "diffs"
            ],
            "copy": [
                {
                    "src": "/root/diffray-task/corpus/png",
                    "dest": "seeds/"
                },
                {
                    "src": "/root/diffray-task/bin/diffray",
                    "dest": "diffray"
                }
            ],
            "create_files": [],
            "commands": [
                {
                    "cmd": "{fuzzer} -t {max_time} -c -o {output_dir} -i {seed_dir} --corpus {corpus_dir} {verbose} -l {log_dir} --cov-mode {cov_mode} --rv-mode {rv_mode}",
                    "mode": "bg_no_output",
                    "redirect_output": false
                }
            ]
        },
        {
            "id": "max-min",
            "comment": "DiffRay Coverage Max-Min Strategy",
            "cpus": 1,
            "params": {
                "fuzzer": "diffray",
                "max_time": 86400,
                "output_dir": "diffs",
                "corpus_dir": "corpus",
                "seed_dir": "seeds",
                "log_dir": "log",
                "verbose": "-v",
                "cov_mode": "single",
                "rv_mode": "none"
            },
            "prepare": [
                "seeds",
                "log",
                "corpus",
                "diffs"
            ],
            "copy": [
                {
                    "src": "/root/diffray-task/corpus/png",
                    "dest": "seeds/"
                },
                {
                    "src": "/root/diffray-task/bin/diffray",
                    "dest": "diffray"
                }
            ],
            "create_files": [],
            "commands": [
                {
                    "cmd": "{fuzzer} -t {max_time} -c -o {output_dir} -i {seed_dir} --corpus {corpus_dir} {verbose} -l {log_dir} --cov-mode {cov_mode} --rv-mode {rv_mode}",
                    "mode": "bg_no_output",
                    "redirect_output": false
                }
            ]
        }
    ]
}
