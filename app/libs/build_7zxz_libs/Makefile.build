# FLAGS := -fsanitize=address,fuzzer-no-link -fsanitize-coverage=edge,indirect-calls -Wall 
# CC := /home/user/software/llvm-project/build/bin/clang
# CXX := /home/user/software/llvm-project/build/bin/clang++


LD_FLAGS := -rdynamic -shared 

all:
	mkdir -p output/
	find ./ -name "*.c" -exec $(CC) $(CFLAGS) -Wimplicit-function-declaration -c {} -o output/{}.o \;
	ar rcs output/lib7zxz_$(COMMIT_HASH).a output/*.o
	cp output/lib7zxz_$(COMMIT_HASH).a ./

7z_parse:
	rm -f output/7z_parse.c.o
	$(CC) -c 7z_parse.c -fsanitize=address,fuzzer-no-link -o output/7z_parse.c.o

app:
	$(CC) -fsanitize=address,fuzzer-no-link output/*.o -o app

clean:
	rm -f output/*.o
