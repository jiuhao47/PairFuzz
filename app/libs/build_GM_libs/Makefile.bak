
CXX := clang++
CC := clang

FLAGS := -O2 -Wall -g -ggdb3 -fsanitize=address,fuzzer-no-link 
LDFLAGS := -rdynamic -shared 

# 14303 17300
OLD_BASE_PATH := /home/fdl/diff-fuzz/examples/builds/libs/graphicsmagick_oldest
NEW_BASE_PATH := /home/fdl/diff-fuzz/examples/builds/libs/graphicsmagick_newest


OLD_INC_PATH := -I${OLD_BASE_PATH}/include/GraphicsMagick 
OLD_LIB_PATH := -L${OLD_BASE_PATH}/lib/
OLD_DYN_LIBS := -Wl,-Bdynamic,-rpath,${OLD_BASE_PATH}/lib/

NEW_INC_PATH := -I${NEW_BASE_PATH}/include/GraphicsMagick 
NEW_LIB_PATH := -L${NEW_BASE_PATH}/lib/
NEW_DYN_LIBS := -Wl,-Bdynamic,-rpath,${NEW_BASE_PATH}/lib/

LIBS :=  -lGraphicsMagick++ -lGraphicsMagick -lSM -lICE -lX11 -llzma -lz -lm -lpthread 

all: genlib test

genlib: parseGM.cpp
	$(CXX) $(OLD_INC_PATH) ${FLAGS} -fPIC -c parseGM.cpp -o parseGM_old.o
	$(CXX) $(LDFLAGS) $(OLD_LIB_PATH) $(OLD_DYN_LIBS) parseGM_old.o -o libparseGM_oldest.so $(LIBS)
	$(CXX) $(FLAGS) $(NEW_INC_PATH) -fPIC -c -o parseGM_new.o parseGM.cpp
	$(CXX) $(LDFLAGS) $(NEW_LIB_PATH) $(NEW_DYN_LIBS) parseGM_new.o -o libparseGM_newest.so $(LIBS)


test: test.cpp
	$(CXX) -g -O2 -fsanitize=address,fuzzer-no-link test.cpp -o test -ldl


clean:
	rm -f *.so
	rm -f *.o
	rm -f test